# Existing infrastructure network (Traefik, Postgres, Redis).
DOCKER_NETWORK=kayord_default
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=letsencrypt
CLUB_HOST=club.example.com
APP_URL=https://club.example.com

# Create a dedicated club database/user; do not use the POS database.
CLUB_DATABASE_CONNECTION='Host=postgres;Port=5432;Database=club;Username=club;Password=REPLACE_ME'
CLUB_REDIS_CONNECTION='redis:6379,password=REPLACE_ME'

KEYCLOAK_URL=https://auth.example.com
KEYCLOAK_REALM=kayord
IDENTITY_URL=https://auth.example.com/realms/kayord
KEYCLOAK_AUDIENCE=public-client
KEYCLOAK_ADMIN_CLIENT_ID=admin-client
KEYCLOAK_ADMIN_CLIENT_SECRET=REPLACE_ME

# Generate each independently: openssl rand -hex 32
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_CHARACTERS
APP_ENCRYPTION_KEY=REPLACE_ME
APP_ENCRYPTION_SALT=REPLACE_ME
TICKERQ_USERNAME=club-admin
TICKERQ_PASSWORD=REPLACE_ME

# Required to send booking emails.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_EMAIL=bookings@example.com
SMTP_PASSWORD=REPLACE_ME
SMTP_NAME=Club

# Required for image uploads (current backend uses explicit credentials).
S3_REGION=af-south-1
S3_BUCKET=aviate-club
S3_ACCESS_KEY_ID=REPLACE_ME
S3_SECRET_ACCESS_KEY=REPLACE_ME

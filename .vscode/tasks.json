{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "API",
      "type": "shell",
      "command": "dotnet",
      "args": ["run", "--project", "Club.Api/club.csproj", "--no-restore"],
      "problemMatcher": "$msCompile",
    },
    {
      "label": "EF Migration Add",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "ef",
        "migrations",
        "add",
        "${input:migrationId}",
        "--project",
        "Club.Api/club.csproj",
        "--startup-project",
        "Club.Api/club.csproj",
        "--context",
        "AppDbContext",
        "-o",
        "Data/Migrations",
      ],
      "problemMatcher": "$msCompile",
      "options": {},
    },
    {
      "label": "EF Migration Remove",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "ef",
        "migrations",
        "remove",
        "--project",
        "Club.Api/club.csproj",
        "--startup-project",
        "Club.Api/club.csproj",
        "--context",
        "AppDbContext",
      ],
      "problemMatcher": "$msCompile",
      "options": {
        "env": {
          "ASPNETCORE_ENVIRONMENT": "Development",
        },
      },
    },
    {
      "label": "EF Revert",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "ef",
        "database",
        "update",
        "${input:lastgoodmigration}",
        "--project",
        "Club.Api/club.csproj",
        "--startup-project",
        "Club.Api/club.csproj",
        "--context",
        "AppDbContext",
      ],
      "problemMatcher": "$msCompile",
      "options": {
        "env": {
          "ASPNETCORE_ENVIRONMENT": "Development",
        },
      },
    },
  ],
  "inputs": [
    {
      "id": "migrationId",
      "type": "promptString",
      "default": "migrationName",
      "description": "dotnet ef with required options",
    },
    {
      "id": "lastgoodmigration",
      "type": "promptString",
      "default": "migrationName",
      "description": "last good migration to revert to",
    },
  ],
}

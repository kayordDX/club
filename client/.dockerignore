# Version control
.git
.gitignore

# Dependencies (installed inside the build stage)
node_modules

# Build output (produced inside the image — never copy a stale host build)
build
.svelte-kit

# Local env / secrets (must never be baked into the image)
.env
.env.*
!.env.example

# Tests & tooling artifacts
e2e
test-results
playwright-report
playwright/.cache
coverage
*.log
pnpm-debug.log*

# Editors / IDE / OS
.vscode
.idea
.DS_Store

# Docker
Dockerfile*
.dockerignore
docker-compose*

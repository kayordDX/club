{
	"name": "client",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"start": "node build",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"lint:fix": "eslint . --fix",
		"test:unit": "vitest",
		"test": "pnpm run test:unit -- --run && pnpm run test:e2e",
		"test:e2e": "playwright test",
		"test:install": "pnpm exec playwright install chromium",
		"api": "pnpm run api:swagger && pnpm run api:orval && pnpm run api:remote && pnpm run format",
		"api:swagger": "curl http://localhost:5000/openapi/v1.json > swagger.json",
		"api:orval": "orval",
		"api:remote": "node ../tools/gen-remote.mjs"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.0",
		"@eslint/config-helpers": "^0.7.0",
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/inter": "^5.3.0",
		"@internationalized/date": "^3.12.3",
		"@kayord/ui": "^4.0.1",
		"@lucide/svelte": "^1.34.0",
		"@playwright/test": "^1.62.1",
		"@sveltejs/adapter-node": "^5.2.0",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/svelte-form": "^1.33.5",
		"@tanstack/svelte-table": "^9.1.2",
		"@types/node": "^26.2.0",
		"@vitest/browser": "^4.1.11",
		"@vitest/browser-playwright": "^4.1.11",
		"eslint": "^10.9.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.11.0",
		"jwt-decode": "^4.0.0",
		"layerchart": "2.3.0",
		"mode-watcher": "^1.1.0",
		"orval": "^8.26.0",
		"playwright": "^1.62.1",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"runed": "^0.37.1",
		"shadcn-svelte": "^1.5.0",
		"svelte": "^5.56.10",
		"svelte-check": "^4.7.6",
		"svelte-sonner": "^1.2.1",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.68.0",
		"vite": "^8.2.2",
		"vitest": "^4.1.11",
		"vitest-browser-svelte": "^3.0.0",
		"zod": "^4.4.3"
	},
	"dependencies": {
		"@humanspeak/svelte-markdown": "^1.8.7",
		"openid-client": "^6.8.7"
	}
}

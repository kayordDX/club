{
	"name": "client",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"lint:fix": "eslint . --fix",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright test",
		"test:install": "pnpm exec playwright install chromium",
		"api": "pnpm run api:swagger && npm run api:orval",
		"api:swagger": "curl http://localhost:5000/openapi/v1.json > swagger.json",
		"api:orval": "orval"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.0",
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/inter": "^5.3.0",
		"@internationalized/date": "^3.12.3",
		"@kayord/ui": "^3.0.11",
		"@lucide/svelte": "^1.28.0",
		"@playwright/test": "^1.62.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.2",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/svelte-form": "^1.33.3",
		"@tanstack/svelte-query": "^6.1.38",
		"@tanstack/table-core": "^8.21.3",
		"@types/node": "^26.1.2",
		"@vitest/browser": "^4.1.10",
		"@vitest/browser-playwright": "^4.1.10",
		"eslint": "^10.8.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.22.0",
		"globals": "^17.8.0",
		"jwt-decode": "^4.0.0",
		"layerchart": "2.0.4",
		"mode-watcher": "^1.1.0",
		"oidc-client-ts": "^3.5.0",
		"orval": "^8.23.0",
		"playwright": "^1.62.1",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"runed": "^0.37.1",
		"shadcn-svelte": "^1.4.2",
		"svelte": "^5.56.8",
		"svelte-check": "^4.7.4",
		"svelte-sonner": "^1.1.1",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.65.0",
		"vite": "^8.2.0",
		"vitest": "^4.1.10",
		"vitest-browser-svelte": "^3.0.0",
		"zod": "^4.4.3"
	},
	"dependencies": {
		"@humanspeak/svelte-markdown": "^1.8.5"
	}
}

{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"sourceMap": true,
		"strict": true
	},
	"exclude": ["src/service-worker"],
	"include": [
		"./.svelte-kit/ambient.d.ts",
		"./.svelte-kit/env.d.ts",
		"./.svelte-kit/non-ambient.d.ts",
		"./.svelte-kit/types/**/$types.d.ts",
		"./vite.config.js",
		"./vite.config.ts",
		"./src/**/*.js",
		"./src/**/*.ts",
		"./src/**/*.svelte",
		"./test/**/*.js",
		"./test/**/*.ts",
		"./test/**/*.svelte",
		"./tests/**/*.js",
		"./tests/**/*.ts",
		"./tests/**/*.svelte",
		"./e2e/**/*.ts",
		"./playwright.config.ts"
	]
}
